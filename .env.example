# Copy to .env before the first run:  copy .env.example .env
POSTGRES_USER=homeflow
POSTGRES_PASSWORD=homeflow
POSTGRES_DB=homeflow

RABBITMQ_USER=homeflow
RABBITMQ_PASSWORD=homeflow

MINIO_ROOT_USER=homeflow
MINIO_ROOT_PASSWORD=homeflow123
S3_ACCESS_KEY=homeflow
S3_SECRET_KEY=homeflow123
S3_BUCKET=documents

# Ollama runs inside Compose. No separate installation needed.
OLLAMA_BASE_URL=http://ollama:11434

# Models. Small for the real-time check, larger for extraction.
CLASSIFIER_MODEL=gemma3:4b
VISION_MODEL=gemma3:4b
EXTRACTOR_MODEL=llama3.1:8b
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text


VITE_API_BASE=http://localhost:8000/api/v1

# Authentication and local reset-email inbox
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=HomeFlow <no-reply@homeflow.local>
SMTP_STARTTLS=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173



# Optional metadata-only chat evaluation lake (no question/answer/document text).
CHAT_EVALUATION_ENABLED=false
CHAT_EVALUATION_BUCKET=chat-evaluations
CHAT_EVALUATION_RETENTION_DAYS=30
# Set a dedicated random secret for stable pseudonyms across restarts; never commit it.
CHAT_EVALUATION_HMAC_KEY=
