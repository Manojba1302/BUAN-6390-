  "steps": [
    {
      "id": "start",
      "label": "Get started",
      "title": "Let’s make your next move happen.",
      "lede": "Start with your plans and a few details about you. You can move between sections as you gather the information you need.",
      "groups": [
        {
          "title": "What are you doing?",
          "fields": [
            "loanPurpose"
          ]
        },
        {
          "title": "About you",
          "fields": [
            "firstName",
            "lastName",
            "email",
            "phone"
          ]
        },
        {
          "title": "The property",
          "fields": [
            "propertyValue",
            "propertyState",
            "downPayment"
          ],
          "computed": [
            {
              "id": "loanAmount",
              "label": "Estimated loan amount",
              "formula": "propertyValue - downPayment"
            }
          ]
        },
        {
          "title": "Your employment situation",
          "fields": [
            "employmentStatus"
          ],
          "hint": "This helps us show the income questions and document requests that apply to you."
        }
      ]
    },
    {
      "id": "documents",
      "label": "Documents",
      "title": "Your documents",
      "lede": "Choose a document type, then select a file to preview. The current prototype sends files to the server for classification when selected.",
      "groups": []
    },
    {
      "id": "about",
      "label": "About you",
      "title": "About you",
      "lede": "Your personal details, kept clear and easy to review. Sensitive numbers show only their last four digits by default.",
      "groups": [
        {
          "title": "Your details",
          "fields": [
            "dob",
            "ssn",
            "citizenship",
            "maritalStatus",
            "dependents"
          ]
        },
        {
          "title": "Where you live now",
          "fields": [
            "addr1",
            "city",
            "state",
            "zip",
            "housing",
            "yearsAt",
            "rent"
          ]
        }
      ]
    },
    {
      "id": "property",
      "label": "Property",
      "title": "The property and the loan",
      "lede": "Tell us about the home itself. If you have not chosen one yet, give us the area and we will update it later.",
      "groups": [
        {
          "title": "Property address",
          "fields": [
            "propAddr1",
            "propCity",
            "propState",
            "propZip",
            "yearBuilt"
          ]
        },
        {
          "title": "How will you use it?",
          "fields": [
            "propertyUse",
            "propertyType"
          ]
        },
        {
          "title": "Title",
          "hint": "Your closing agent will confirm these. A best guess is fine for now.",
          "fields": [
            "estateHeld",
            "titleManner"
          ]
        }
      ]
    },
    {
      "id": "money",
      "label": "Income & finances",
      "title": "Your work. Your income. Your future.",
      "lede": "Everyone’s income looks different. Choose your current situation and we’ll show the details that apply to you. You can include other income you want considered.",
      "groups": [
        {
          "title": "Which situation describes you?",
          "fields": [
            "employmentStatus"
          ],
          "hint": "Changing your selection keeps your other answers available if you switch back."
        },
        {
          "title": "Employment and gross monthly income",
          "repeatable": "employment",
          "visible_if": {
            "field": "employmentStatus",
            "equals": "Employed"
          }
        },
        {
          "title": "Your business",
          "visible_if": {
            "field": "employmentStatus",
            "equals": "Self-employed"
          },
          "fields": [
            "businessName",
            "businessType",
            "businessStartDate",
            "ownershipPercent",
            "businessPhone",
            "businessAddress",
            "selfEmploymentIncome"
          ],
          "hint": "Enter net business income after business expenses. Your loan officer will review the supporting information."
        },
        {
          "title": "Retirement and benefits",
          "visible_if": {
            "field": "employmentStatus",
            "equals": "Retired"
          },
          "fields": [
            "retirementDate",
            "pensionProvider",
            "pensionIncome",
            "socialSecurityIncome",
            "retirementIncome"
          ],
          "hint": "No employer details are needed. Include only income you want considered."
        },
        {
          "title": "Your current income",
          "visible_if": {
            "field": "employmentStatus",
            "equals": "Not currently employed"
          },
          "fields": [
            "lastEmploymentDate",
            "notEmployedIncome"
          ],
          "hint": "You can enter zero if you have no current income. Add other sources below if applicable."
        },
        {
          "title": "Tell us about your situation",
          "visible_if": {
            "field": "employmentStatus",
            "equals": "Other"
          },
          "fields": [
            "otherSituation",
            "otherSituationIncome"
          ]
        },
        {
          "title": "Additional gross monthly income",
          "fields": [
            "additionalIncomeSource",
            "additionalIncomeAmount"
          ],
          "hint": "Include only income you want considered. Alimony, child support and separate maintenance income need not be revealed unless you want it considered."
        },
        {
          "title": "Current monthly housing expenses",
          "fields": [
            "exp_firstMortgage",
            "exp_hazard",
            "exp_taxes",
            "exp_mi",
            "exp_hoa",
            "exp_other"
          ],
          "computed": [
            {
              "id": "housingTotal",
              "label": "Total",
              "formula": "sum(exp_*)"
            }
          ]
        },
        {
          "title": "Accounts and assets",
          "repeatable": "asset"
        },
        {
          "title": "Debts and other monthly payments",
          "repeatable": "liability"
        }
      ]
    },
    {
      "id": "review",
      "label": "Review",
      "title": "Check it, then send it",
      "lede": "Everything you have given us, in one place. Anything still outstanding is marked.",
      "groups": [
        {
          "title": "Electronic documents",
          "fields": [
            "econsent"
          ]
        },
        {
          "title": "Declarations",
          "declarations": true
        }
      ]
    }
  ],
